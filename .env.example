# ─────────────────────────────────────────────────────────────
#  My Pick 설정 — 이 파일을 .env 로 복사해서 고친 뒤 띄워 주세요.
#  (.env 는 깃허브 · 배포 묶음에 올라가지 않아요. 바꾸면 서버를 다시 띄워야 해요.)
# ─────────────────────────────────────────────────────────────

# ── 꼭 정해야 하는 것 (정식으로 운영하기 전에) ──
# 1) 관리자 아이디 · 비밀번호 (비밀번호는 8자 이상. 없으면 관리자 로그인이 꺼져요)
ADMIN_ID=admin
ADMIN_PASSWORD=여기에-비밀번호
# 2) 운영하는 곳의 연락처: 개인정보 처리방침의 ‘개인정보 보호책임자 · 문의’ 와 이용약관의 ‘문의’ 에 나와요.
#    개인정보 처리방침에는 문의할 곳이 꼭 있어야 해요 (비워 두면 ‘안내한 담당자에게 물어 주세요’ 로 나와요)
# CONTACT=담당 부서 · 031-000-0000 · help@example.kr
# 3) 기록을 봉하는 열쇠. 넣으면 저장 파일 · 백업만 가진 사람은 기록을 꾸며 낼 수 없어요. 길고 아무렇게나 (예: openssl rand -hex 32)
#    이미 쌓인 기록이 있으면 넣은 뒤 한 번: docker compose exec web node server.mjs --rekey-audit
#    이 값을 바꾸거나 잃어버리면 그전 기록은 ‘어긋남’으로 보여요. 안전한 곳에 따로 적어 두세요.
# AUDIT_SECRET=
# 4) 밖에서 쓸 때는 실제 주소와 HTTPS (아래 ‘접속’ · ‘저장 · 라이선스’ 의 SITE_URL · DOMAIN)

# ── 기관 ──
# 화면 맨 위에 나오는 기관 이름 (관리자 화면에서도 바꿀 수 있어요. 로고 사진은 관리자 화면에서 올려요)
ORG_NAME=My Pick
# 로고 사진 크기 한도 (MB)
# MAX_LOGO_MB=2

# ── 접속 ──
# 바깥에서 들어올 포트 (기본 8082)
# PORT=8082
# 실제 사이트 주소. 정하면 큰 화면의 QR · 입장 주소가 이걸로 나와요
# SITE_URL=https://vote.example.kr
# 리버스 프록시(HTTPS) 뒤에 둘 때만 1 로. 프록시가 X-Forwarded-For · X-Forwarded-Proto 를 붙여야 해요
# 프록시가 하나일 때만 켜 주세요: X-Forwarded-For 의 맨 끝(우리 프록시가 붙인 주소)만 믿어요. 프록시가 둘 이상이면 모두가 같은 주소로 보여요.
# TRUST_PROXY=1

# ── 픽 기본값 (방을 만들 때 채워지는 값. 방마다 바꿀 수 있어요) ──
# 주제 하나의 제한 시간(초). 0 이면 제한 없음
# DEFAULT_VOTE_SECONDS=60
# 접속이 끊긴 사람을 기다리는 시간(초). 지나면 그 사람은 빼고 ‘모두 픽함’을 따져요
# DEFAULT_GRACE_SECONDS=15

# ── 누구나 방 만들기 (방장) ──
# 가입 없이 누구나 방을 만들 수 있게 할지. 관리자만 만들게 하려면 0
# PUBLIC_ROOMS=1
# 방장이 만든 방은 마지막으로 쓴 뒤 며칠이 지나면 자동으로 지울지 (관리자가 만든 방은 지우지 않아요)
# ROOM_KEEP_DAYS=7
# 한 접속 주소에서 한 시간에 만들 수 있는 방 수 · 방장이 만든 방의 전체 한도
# PUBLIC_ROOMS_PER_HOUR=5
# MAX_PUBLIC_ROOMS=200
# 방장 로그인이 유지되는 시간 (시간 단위)
# HOST_SESSION_HOURS=24

# ── 확인 요청 ──
# 마감 뒤 확인 요청을 받을 시간(분). 0 이면 받지 않아요
# OBJECTION_MINUTES=10

# ── 저장 · 라이선스 ──
# 하루 한 번 저장 파일을 통째로 백업해요 (볼륨 안 backups 폴더). 며칠치를 둘지, 0 이면 끔
# (지워진 방도 백업 안에는 이 기간만큼 남아 있어요)
# BACKUP_KEEP_DAYS=7
# 소스 코드 주소. 넣으면 첫 화면 아래에 ‘소스 코드’ 링크가 나와요 (AGPL: 고쳐서 서비스하면 고친 소스를 받을 수 있게 해야 해요)
# SOURCE_URL=https://github.com/hatility/My-Pick
# HTTPS 로 띄울 때 (docker-compose.https.yml): 도메인. SITE_URL 도 같이 https:// 로 넣어 주세요
# DOMAIN=vote.example.kr

# ── 보안 ──
# 관리자 로그인을 몇 번 틀리면 잠글지 · 몇 분 잠글지
# LOGIN_LOCK_AFTER=5
# LOGIN_LOCK_MINUTES=10
# 방 입장(비밀번호 · 입장 코드)을 몇 번 틀리면 잠글지 · 몇 초 잠글지
# (학교처럼 모두 같은 인터넷 주소를 쓰는 곳에서는 한 사람의 실수로 모두가 잠기지 않게 짧게 두세요)
# JOIN_LOCK_AFTER=10
# JOIN_LOCK_SECONDS=60
# 로그인이 유지되는 시간 (시간 단위)
# ADMIN_SESSION_HOURS=12
# VOTER_SESSION_HOURS=168
# 동시에 받을 실시간 연결 수
# MAX_CONNECTIONS=5000
