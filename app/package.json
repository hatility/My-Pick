{
  "name": "my-pick",
  "version": "0.1.0-dev",
  "description": "My Pick — 익명으로 함께 고르는 My Pick",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "LISTEN_PORT=8788 DATA_DIR=.data node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.mjs --api-only & vite --port 5200",
    "build": "tsc --noEmit && vite build",
    "test": "node --disable-warning=ExperimentalWarning scripts/check.mjs",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.mjs",
    "e2e": "node --env-file-if-exists=.env scripts/e2e.mjs",
    "load": "node --env-file-if-exists=.env scripts/load.mjs",
    "samples": "node --env-file-if-exists=.env scripts/samples.mjs",
    "audit": "node --env-file-if-exists=.env scripts/audit.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  },
  "license": "AGPL-3.0-or-later"
}
